# Production — all hosts live under the recycleorigin.xyz zone.
# DNS: app -> customer web; api.app -> API (see backend/docs/deployment/godaddy-dns.md).
# Do not point this file at staging or localhost for store / prod builds.

ENVIRONMENT=production
API_BASE_URL=https://api.app.recycleorigin.xyz/
API_ROOT_URL=https://api.app.recycleorigin.xyz/rest/recycleorigin/v1
GOOGLE_MAPS_API_KEY=
